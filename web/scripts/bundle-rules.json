{
  "index.html": {
    "forbidChunks": [
      "src/plan/**",
      "node_modules/@codemirror/**",
      "node_modules/@lezer/**",
      "assets/cm-view.js",
      "assets/cm-lang.js",
      "node_modules/@fontsource-variable/source-serif-4/**",
      "node_modules/@fontsource-variable/literata/**",
      "node_modules/@fontsource-variable/piazzolla/**",
      "src/plan/editor/codemirror.ts"
