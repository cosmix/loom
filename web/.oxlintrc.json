{
  "plugins": ["unicorn", "typescript", "oxc", "react"],
  "ignorePatterns": ["dist/**", "src/components/ui/**", "src/aurora-ui/**"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "zod",
            "message": "Import z from \"@/api/zod\" instead: it sets jitless before any schema is built, which keeps zod's `new Function` probe from tripping the dashboard's CSP."
          }
        ]
      }
    ],
    "react/rules-of-hooks": "error",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/static-components": "off",
    "react/globals": "off",
    "react/jsx-key": "off",
    "react/exhaustive-deps": "off"
  },
  "overrides": [
    {
      "files": ["src/api/zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/*.test.tsx", "**/*.test.ts"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
