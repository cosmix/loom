    "jotai": "2.20.3",
    "lucide-react": "^1.41.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "shadcn": "4.21.0",
