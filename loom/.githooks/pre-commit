#!/bin/sh
# Pre-commit hook: auto-format Rust and markdown files

# Get the repo root (where .git is)
REPO_ROOT="$(git rev-parse --show-toplevel)"

echo "Running pre-commit formatting..."

# Get list of staged files before formatting
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Auto-format Rust code
echo "Formatting Rust code..."
cd "$REPO_ROOT/loom" || exit 1
cargo fmt

# Auto-fix tracked markdown files only
echo "Linting markdown files..."
cd "$REPO_ROOT" || exit 1
MD_FILES=$(git ls-files '*.md')
if [ -n "$MD_FILES" ]; then
    echo "$MD_FILES" | xargs bunx markdownlint-cli2 --fix 2>/dev/null || true
fi

# Re-add any staged files that were modified by formatting
if [ -n "$STAGED_FILES" ]; then
    echo "Re-staging formatted files..."
    echo "$STAGED_FILES" | while read -r file; do
        if [ -f "$file" ]; then
            git add "$file"
        fi
    done
fi

# Maintainability ledger gate: catches growth of ledgered files/functions at
# commit time instead of push time. Fast when the build is warm.
cd "$REPO_ROOT/loom" || exit 1
echo "Checking maintainability limits..."
if ! cargo test --quiet --test maintainability 2>&1; then
    echo ""
    echo "ERROR: maintainability gate failed - a ledgered file or function grew,"
    echo "or a new file/function exceeds the limits."
    echo "Refactor (extract into a new module) instead of growing ledgered code;"
    echo "growth is never recordable in loom/maintainability-baseline.txt."
    echo ""
    exit 1
fi

# Rustdoc gate, fired only when the staged diff adds or edits a doc comment.
# rustdoc lints (private intra-doc links above all) are invisible to cargo
# build, clippy and test, so without this they surface at push time or in CI.
if git diff --cached --diff-filter=ACM -U0 -- '*.rs' | grep -qE '^\+[[:space:]]*(///|//!)'; then
    echo "Checking rustdoc (doc comments changed)..."
    if ! RUSTDOCFLAGS="-D warnings" cargo doc --workspace --all-features --no-deps 2>&1; then
        echo ""
        echo "ERROR: rustdoc found issues (private intra-doc links, etc.)."
        echo "A [\`name\`] link in a doc comment must resolve as a public path;"
        echo "for a private fn, const or field write a plain code span \`name\`."
        echo ""
        exit 1
    fi
fi

echo "Pre-commit formatting complete."
