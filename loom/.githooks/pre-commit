#!/usr/bin/env bash
# Pre-commit hook: auto-format Rust and markdown files

# An inherited GIT_LITERAL_PATHSPECS disables the ":(literal)" magic below, so the partial-staging guard would match nothing and let a partial index through.
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS

# Get the repo root (where .git is)
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Keep the NUL-delimited list so formatter changes can be re-staged later.
if ! STAGED_FILE_LIST=$(mktemp "${TMPDIR:-/tmp}/loom-pre-commit.XXXXXX"); then
    echo "ERROR: failed to create the staged-file list." >&2
    exit 1
fi
trap 'rm -f "$STAGED_FILE_LIST"' EXIT

cd "$REPO_ROOT" || exit 1

# Refuse partial staging before formatters rewrite the index; --no-renames lists a rename's new path as an addition.
if ! git diff --cached --no-renames --name-only -z --diff-filter=ACMT > "$STAGED_FILE_LIST"; then
    echo "ERROR: failed to enumerate staged files." >&2
    exit 1
fi

PARTIAL_STAGING=0
while IFS= read -r -d '' file; do
    git diff --quiet -- ":(literal)$file"
    diff_status=$?
    if [ "$diff_status" -eq 0 ]; then
        continue
    fi

    if [ "$diff_status" -eq 1 ]; then
        if [ "$PARTIAL_STAGING" -eq 0 ]; then
            echo "ERROR: these staged paths also have unstaged changes:" >&2
        fi
        printf '%s\n' "$file" >&2
        PARTIAL_STAGING=1
        continue
    fi

    printf 'ERROR: failed to compare staged path with the working tree: %s\n' "$file" >&2
    exit 1
done < "$STAGED_FILE_LIST"

if [ "$PARTIAL_STAGING" -eq 1 ]; then
    echo "Fully stage the path, unstage it, or land the other work first." >&2
    echo 'Recovery: doc/loom/knowledge/mistakes/testing-and-lint.md, section "The Pre-Commit Hook Re-Adds Every Staged File, So Partial Staging Is Silently Undone".' >&2
    exit 1
fi

LEDGER=loom/maintainability-baseline.txt
git diff --quiet -- ":(literal)$LEDGER"
LEDGER_DIFF_STATUS=$?
if [ "$LEDGER_DIFF_STATUS" -gt 1 ]; then
    echo "ERROR: failed to compare the staged ledger with the working tree: $LEDGER" >&2
    exit 1
fi

LEDGER_HASH_BEFORE=
if [ -e "$LEDGER" ]; then
    LEDGER_HASH_BEFORE=$(git hash-object -- "$LEDGER") || exit 1
fi

echo "Running pre-commit formatting..."

# Auto-format Rust code
echo "Formatting Rust code..."
cd "$REPO_ROOT/loom" || exit 1
cargo fmt

# Auto-fix staged markdown only, skipping what pre-push skips: markdownlint-cli2
# does not apply .markdownlintignore to paths named on its command line, and a
# fix to an unstaged file would be left rewritten and uncommitted.
echo "Linting markdown files..."
cd "$REPO_ROOT" || exit 1
STAGED_MD=()
while IFS= read -r -d '' file; do
    case "$file" in
        doc/plans/* | loom/tests/fixtures/*) ;;
        *.md) STAGED_MD+=("$file") ;;
    esac
done < "$STAGED_FILE_LIST"
if [ "${#STAGED_MD[@]}" -gt 0 ]; then
    MD_OUT=$(bunx markdownlint-cli2 --fix "${STAGED_MD[@]}" 2>&1) || true
    # The version banner is the only proof the linter ran: bunx dies silently
    # when the sandbox blocks its cache or the registry. Warn only; pre-push gates.
    case "$MD_OUT" in
        *'markdownlint-cli2 v'*) ;;
        *)
            echo "WARNING: markdownlint-cli2 could not run - markdown was NOT linted (pre-push will block until it runs)" >&2
            printf '%s\n' "$MD_OUT" | tail -n 5 >&2
            ;;
    esac
fi

# Re-add any staged files that were modified by formatting
if [ -s "$STAGED_FILE_LIST" ]; then
    echo "Re-staging formatted files..."
    while IFS= read -r -d '' file; do
        if [ -f "$file" ]; then
            git add -- ":(literal)$file"
        fi
    done < "$STAGED_FILE_LIST"
fi

# Preserve safe ledger corrections even when growth or new violations fail the gate.
cd "$REPO_ROOT/loom" || exit 1
echo "Checking maintainability limits..."
MAINTAINABILITY_STATUS=0
LOOM_LEDGER_TIGHTEN=1 cargo test --quiet --test maintainability 2>&1 || MAINTAINABILITY_STATUS=$?

LEDGER_STAGE_STATUS=0
LEDGER_HASH_AFTER=
if [ -e "$REPO_ROOT/$LEDGER" ]; then
    LEDGER_HASH_AFTER=$(git -C "$REPO_ROOT" hash-object -- "$LEDGER") || exit 1
fi
if [ "$LEDGER_HASH_BEFORE" != "$LEDGER_HASH_AFTER" ]; then
    if [ "$LEDGER_DIFF_STATUS" -eq 1 ]; then
        echo "ERROR: $LEDGER has unstaged edits and rows that had to be lowered. Stage or discard your edits, then commit again." >&2
        LEDGER_STAGE_STATUS=1
    else
        # Rows measured from unstaged edits may be too low for the index.
        git -C "$REPO_ROOT" diff --quiet -- loom/ ":(exclude,literal)$LEDGER"
        case $? in
            0)
                git -C "$REPO_ROOT" add -- ":(literal)$LEDGER" || exit 1
                echo "Staged the lowered ledger rows in $LEDGER."
                ;;
            1)
                echo "Left $LEDGER unstaged. It must be committed together with the change that shrank the code." >&2
                ;;
            *)
                echo "ERROR: failed to compare staged files under loom/ with the working tree." >&2
                LEDGER_STAGE_STATUS=1
                ;;
        esac
    fi
fi

if [ "$MAINTAINABILITY_STATUS" -ne 0 ]; then
    echo ""
    echo "ERROR: maintainability gate failed - a ledgered file or function grew,"
    echo "or a new file/function exceeds the limits (see the lines above)."
    echo "Refactor (extract into a new module); never raise or add a row in"
    echo "loom/maintainability-baseline.txt."
    echo ""
    exit 1
fi
if [ "$LEDGER_STAGE_STATUS" -ne 0 ]; then
    exit 1
fi

# Rustdoc gate, fired only when the staged diff adds or edits a doc comment.
# rustdoc lints (private intra-doc links above all) are invisible to cargo
# build, clippy and test, so without this they surface at push time or in CI.
if git diff --cached --diff-filter=ACM -U0 -- '*.rs' | grep -qE '^\+[[:space:]]*(///|//!)'; then
    echo "Checking rustdoc (doc comments changed)..."
    if ! RUSTDOCFLAGS="-D warnings" cargo doc --workspace --all-features --no-deps 2>&1; then
        echo ""
        echo "ERROR: rustdoc found issues (private intra-doc links, etc.)."
        echo "A [\`name\`] link in a doc comment must resolve as a public path;"
        echo "for a private fn, const or field write a plain code span \`name\`."
        echo ""
        exit 1
    fi
fi

echo "Pre-commit formatting complete."
