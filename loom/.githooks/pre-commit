#!/usr/bin/env bash
# Pre-commit hook: auto-format Rust and markdown files

# An inherited GIT_LITERAL_PATHSPECS disables the ":(literal)" magic below, so the partial-staging guard would match nothing and let a partial index through.
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS

# Get the repo root (where .git is)
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Keep the NUL-delimited list so formatter changes can be re-staged later.
if ! STAGED_FILE_LIST=$(mktemp "${TMPDIR:-/tmp}/loom-pre-commit.XXXXXX"); then
    echo "ERROR: failed to create the staged-file list." >&2
    exit 1
fi
trap 'rm -f "$STAGED_FILE_LIST"' EXIT

cd "$REPO_ROOT" || exit 1

# Refuse partial staging before formatters rewrite the index; --no-renames lists a rename's new path as an addition.
if ! git diff --cached --no-renames --name-only -z --diff-filter=ACMT > "$STAGED_FILE_LIST"; then
    echo "ERROR: failed to enumerate staged files." >&2
    exit 1
fi

PARTIAL_STAGING=0
while IFS= read -r -d '' file; do
    git diff --quiet -- ":(literal)$file"
    diff_status=$?
    if [ "$diff_status" -eq 0 ]; then
        continue
    fi

    if [ "$diff_status" -eq 1 ]; then
        if [ "$PARTIAL_STAGING" -eq 0 ]; then
            echo "ERROR: these staged paths also have unstaged changes:" >&2
        fi
        printf '%s\n' "$file" >&2
        PARTIAL_STAGING=1
        continue
    fi

    printf 'ERROR: failed to compare staged path with the working tree: %s\n' "$file" >&2
    exit 1
done < "$STAGED_FILE_LIST"

if [ "$PARTIAL_STAGING" -eq 1 ]; then
    echo "Fully stage the path, unstage it, or land the other work first." >&2
    echo 'Recovery: doc/loom/knowledge/mistakes/testing-and-lint.md, section "The Pre-Commit Hook Re-Adds Every Staged File, So Partial Staging Is Silently Undone".' >&2
    exit 1
fi

echo "Running pre-commit formatting..."

# Auto-format Rust code
echo "Formatting Rust code..."
cd "$REPO_ROOT/loom" || exit 1
cargo fmt

# Auto-fix tracked markdown files only
echo "Linting markdown files..."
cd "$REPO_ROOT" || exit 1
if [ -n "$(git ls-files -- '*.md')" ]; then
    git ls-files -z -- '*.md' | xargs -0 bunx markdownlint-cli2 --fix 2>/dev/null || true
fi

# Re-add any staged files that were modified by formatting
if [ -s "$STAGED_FILE_LIST" ]; then
    echo "Re-staging formatted files..."
    while IFS= read -r -d '' file; do
        if [ -f "$file" ]; then
            git add -- ":(literal)$file"
        fi
    done < "$STAGED_FILE_LIST"
fi

# Maintainability ledger gate: catches growth of ledgered files/functions at
# commit time instead of push time. Fast when the build is warm.
cd "$REPO_ROOT/loom" || exit 1
echo "Checking maintainability limits..."
if ! cargo test --quiet --test maintainability 2>&1; then
    echo ""
    echo "ERROR: maintainability gate failed - a ledgered file or function grew,"
    echo "or a new file/function exceeds the limits."
    echo "Refactor (extract into a new module) instead of growing ledgered code;"
    echo "growth is never recordable in loom/maintainability-baseline.txt."
    echo ""
    exit 1
fi

# Rustdoc gate, fired only when the staged diff adds or edits a doc comment.
# rustdoc lints (private intra-doc links above all) are invisible to cargo
# build, clippy and test, so without this they surface at push time or in CI.
if git diff --cached --diff-filter=ACM -U0 -- '*.rs' | grep -qE '^\+[[:space:]]*(///|//!)'; then
    echo "Checking rustdoc (doc comments changed)..."
    if ! RUSTDOCFLAGS="-D warnings" cargo doc --workspace --all-features --no-deps 2>&1; then
        echo ""
        echo "ERROR: rustdoc found issues (private intra-doc links, etc.)."
        echo "A [\`name\`] link in a doc comment must resolve as a public path;"
        echo "for a private fn, const or field write a plain code span \`name\`."
        echo ""
        exit 1
    fi
fi

echo "Pre-commit formatting complete."
