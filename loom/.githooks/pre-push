#!/bin/sh
# Pre-push hook: ensure Rust code is formatted, passes tests, and clippy

# Get the repo root (where .git is)
REPO_ROOT="$(git rev-parse --show-toplevel)"

# git push opens the connection to the remote and reads its ref advertisement
# before it runs this hook, then holds that connection idle while the checks
# run. The checks take long enough for the remote to close it; git then writes
# to a closed pipe after the hook returns 0 and exits 141 without a message,
# and nothing is pushed. A hook cannot reopen git's connection, so a commit
# that passed is recorded and the same push run again skips the checks.
# scripts/push.sh runs the checks before any connection exists, against the
# commit in a separate check worktree (LOOM_PUSH_CHECK=1), so uncommitted
# files in the operator's checkout do not matter.
#
# Stdin carries one line per ref being updated:
#   <local ref> <local sha> <remote ref> <remote sha>
# Git omits refs that are already up to date. Deletions (all-zero local sha)
# need no checks.
PUSHES=""
while read -r _lref LSHA RREF _rsha; do
    case "$LSHA" in
        *[!0]*) PUSHES="$PUSHES$LSHA $RREF
" ;;
    esac
done
# Keep cargo and the tests off git's pipe.
exec </dev/null

if [ -z "$PUSHES" ]; then
    echo "pre-push: nothing to push; skipping checks."
    exit 0
fi

# One full commit sha per line, shared by every worktree of the repository.
VERIFIED_FILE="$(git rev-parse --path-format=absolute --git-common-dir)/loom-pre-push-verified"

# A tag push never skips: the commit a release tag points at builds the bare
# release version, not "-dev", and the tag push's hook is the first suite run
# against that build (CONTRIBUTING.md, release section). Only branch pushes of
# recorded commits skip.
ALL_VERIFIED=1
SKIPPED=""
while read -r LSHA RREF; do
    [ -n "$LSHA" ] || continue
    case "$RREF" in
        refs/heads/*) ;;
        *) ALL_VERIFIED=0; break ;;
    esac
    if ! git rev-parse --verify -q "$LSHA^{commit}" >/dev/null 2>&1 \
        || ! grep -qx "$LSHA" "$VERIFIED_FILE" 2>/dev/null; then
        ALL_VERIFIED=0
        break
    fi
    SKIPPED="$SKIPPED $(git rev-parse --short "$LSHA")"
done <<EOF
$PUSHES
EOF
if [ "$ALL_VERIFIED" -eq 1 ]; then
    echo "pre-push:$SKIPPED already passed these checks; skipping."
    exit 0
fi

# The checks verify the working tree, so HEAD may be recorded only when the
# tracked tree is clean for the whole run.
HEAD_BEFORE="$(git rev-parse HEAD)"
if [ -z "$(git status --porcelain --untracked-files=no)" ]; then
    TREE_CLEAN_BEFORE=1
else
    TREE_CLEAN_BEFORE=0
fi

# Run checks in the loom directory
cd "$REPO_ROOT/loom" || exit 1

echo "Running pre-push checks..."

# CI installs the latest stable toolchain, so a clippy lint that didn't exist
# when this workstation last updated can fail there while passing here. This
# check is advisory only: never block the push on it, and never let a
# failure of rustup itself (e.g. offline) fail the hook.
if command -v rustup >/dev/null 2>&1; then
    RUSTUP_CHECK=$(rustup check 2>/dev/null || true)
    if echo "$RUSTUP_CHECK" | grep -q '^stable.*Update available'; then
        echo ""
        echo "WARNING: a newer stable Rust is available. CI installs latest stable, so new"
        echo "clippy lints may fail there while passing here. Run 'rustup update stable'"
        echo "and re-run clippy before pushing if you want to be sure."
        echo ""
    fi
fi

# Check formatting
if ! cargo fmt --check 2>/dev/null; then
    echo ""
    echo "ERROR: Rust code is not formatted correctly."
    echo "Run 'cargo fmt' in the loom/ directory to fix."
    echo ""
    exit 1
fi

# Check markdown formatting (tracked files only, respects .markdownlintignore).
# Auto-fix first: only what markdownlint cannot repair itself blocks the push.
cd "$REPO_ROOT" || exit 1
MD_FILES=$(git ls-files '*.md' | grep -v '^doc/plans/' | grep -v '^loom/tests/fixtures/')
if [ -n "$MD_FILES" ]; then
    MD_LOG=$(mktemp)
    MD_SUMS_BEFORE=$(mktemp)
    MD_SUMS_AFTER=$(mktemp)
    trap 'rm -f "$MD_LOG" "$MD_SUMS_BEFORE" "$MD_SUMS_AFTER"' EXIT

    echo "Linting markdown files..."
    echo "$MD_FILES" | xargs cksum > "$MD_SUMS_BEFORE"
    echo "$MD_FILES" | xargs bunx markdownlint-cli2 --fix > "$MD_LOG" 2>&1
    MD_STATUS=$?
    echo "$MD_FILES" | xargs cksum > "$MD_SUMS_AFTER"
    MD_FIXED=$(diff "$MD_SUMS_BEFORE" "$MD_SUMS_AFTER" | grep '^>' | cut -d' ' -f4-)

    # A non-zero status also means "the tool never ran": bunx dies when it
    # cannot write its cache (sandbox) or reach the registry. The version
    # banner is the only proof that anything was actually linted.
    if ! grep -q 'markdownlint-cli2 v' "$MD_LOG"; then
        echo ""
        echo "ERROR: markdownlint-cli2 could not run - markdown was NOT linted."
        cat "$MD_LOG"
        echo ""
        echo "If bun cannot reach its cache, point BUN_INSTALL_CACHE_DIR and"
        echo "TMPDIR at writable directories, then push again."
        echo ""
        exit 1
    fi

    if [ "$MD_STATUS" -ne 0 ]; then
        echo ""
        echo "ERROR: Markdown issues that --fix cannot repair:"
        echo ""
        grep -v '^Finding:' "$MD_LOG"
        if [ -n "$MD_FIXED" ]; then
            echo ""
            if [ -n "$LOOM_PUSH_CHECK" ]; then
                echo "The commit also carries markdown that --fix changes:"
                echo "$MD_FIXED" | sed 's/^/  /'
                echo "Run 'bunx markdownlint-cli2 --fix <files>' in your checkout and commit the result."
            else
                echo "Auto-fixed separately (uncommitted, commit these too):"
                echo "$MD_FIXED" | sed 's/^/  /'
            fi
        fi
        echo ""
        echo "Fix the errors above, commit, then push again."
        echo ""
        exit 1
    fi

    if [ -n "$MD_FIXED" ]; then
        echo ""
        if [ -n "$LOOM_PUSH_CHECK" ]; then
            echo "The commit carries markdown that --fix changes:"
            echo "$MD_FIXED" | sed 's/^/  /'
            echo ""
            echo "Run 'bunx markdownlint-cli2 --fix <files>' in your checkout, commit the result,"
            echo "then push again."
        else
            echo "Markdown lint auto-fixed these files in the working tree:"
            echo "$MD_FIXED" | sed 's/^/  /'
            echo ""
            echo "The commits you are pushing still carry the unfixed markdown."
            echo "Review the fixes, commit them, then push again."
        fi
        echo ""
        exit 1
    fi
fi
cd "$REPO_ROOT/loom" || exit 1

# Run clippy with warnings as errors
if ! cargo clippy --all-targets -- -D warnings 2>&1; then
    echo ""
    echo "ERROR: Clippy found issues."
    echo "Fix the warnings above before pushing."
    echo ""
    exit 1
fi

# Check rustdoc (CI's Documentation job runs the same; rustdoc lints are
# invisible to build/clippy/test)
if ! RUSTDOCFLAGS="-D warnings" cargo doc --workspace --all-features --no-deps 2>&1; then
    echo ""
    echo "ERROR: rustdoc found issues (private intra-doc links, etc.)."
    echo "Fix the warnings above before pushing."
    echo ""
    exit 1
fi

# Audit dependencies for known vulnerabilities
if ! cargo audit 2>&1; then
    echo ""
    echo "ERROR: cargo-audit found vulnerabilities."
    echo "Run 'cargo audit' in the loom/ directory for details."
    echo ""
    exit 1
fi

# Run tests
# Unset git env vars to prevent interference with test repo creation
if ! env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE cargo test --all-targets --no-fail-fast 2>&1; then
    echo ""
    echo "ERROR: Tests failed."
    echo "This run does NOT stop at the first failure - every failure above"
    echo "must be fixed before pushing."
    echo ""
    exit 1
fi

# Re-run the timing-sensitive tests under CPU contention. A single unloaded
# run above passes a race that fires once in ~15 runs, and every recent CI
# failure on push was exactly one of these; CI runs this same job
# (scripts/flake-check.sh), so catching it here saves a round trip.
if ! "$REPO_ROOT/scripts/flake-check.sh"; then
    echo ""
    echo "ERROR: flake-check failed."
    echo "CI runs the same job (scripts/flake-check.sh); the failing run's output is above."
    echo "Fix the race before pushing. To run it alone: ./scripts/flake-check.sh"
    echo ""
    exit 1
fi

echo "All pre-push checks passed."

# Record HEAD only when the checks saw exactly HEAD: clean tracked tree before
# and after, same commit. Keep the last 50 entries.
HEAD_SHORT="$(git rev-parse --short "$HEAD_BEFORE")"
if [ "$TREE_CLEAN_BEFORE" -eq 1 ] \
    && [ -z "$(git status --porcelain --untracked-files=no)" ] \
    && [ "$(git rev-parse HEAD)" = "$HEAD_BEFORE" ]; then
    VERIFIED_TMP="$VERIFIED_FILE.$$"
    { cat "$VERIFIED_FILE" 2>/dev/null; echo "$HEAD_BEFORE"; } | tail -n 50 > "$VERIFIED_TMP"
    mv "$VERIFIED_TMP" "$VERIFIED_FILE"
    if [ -z "$LOOM_PUSH_CHECK" ]; then
        echo "If git prints no \"To <remote>\" line below, the remote closed the connection during the checks and nothing was pushed."
        echo "Run the same push again: $HEAD_SHORT is recorded as verified, so the checks are skipped."
    else
        echo "$HEAD_SHORT recorded as verified."
    fi
else
    if [ "$TREE_CLEAN_BEFORE" -eq 0 ] || [ -n "$(git status --porcelain --untracked-files=no)" ]; then
        WHY="tracked changes present"
    else
        WHY="HEAD moved"
    fi
    if [ -n "$LOOM_PUSH_CHECK" ]; then
        echo "Result not recorded ($WHY in the check worktree $REPO_ROOT; the checks changed it)."
    elif [ "$WHY" = "tracked changes present" ]; then
        echo "Result not recorded ($WHY). scripts/push.sh checks the commit in a separate worktree, so it works with uncommitted changes."
    else
        echo "Result not recorded ($WHY). If the remote closed the connection during the checks, run scripts/push.sh or git push --no-verify."
    fi
fi
