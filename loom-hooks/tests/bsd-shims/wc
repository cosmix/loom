#!/usr/bin/env bash
# loom-bsd-shim
# BSD/macOS wc shim: GNU wc with the BSD output shape. Every leading integer
# field is right-aligned in 8 columns (`wc -c <file` prints "       5"), so a
# hook that tests the raw value against ^[0-9]+$ fails here as it does on macOS.

depth=${LOOM_BSD_SHIM_DEPTH:-0}
((depth < 3)) || { echo "wc: BSD shim re-entered ${depth} times; a PATH wrapper delegates back to it" >&2; exit 125; }
export LOOM_BSD_SHIM_DEPTH=$((depth + 1))

# The real tool is the next PATH entry after this script's own (then /usr/bin,
# /bin). A wrapper earlier on PATH may delegate back to the shim
# (worktree-file-guard-scratchpad's stat stub), so taking the first entry that
# is not this script would pick the wrapper and loop; the depth guard above is
# the backstop. -ef follows symlinks, so a path_without mirror of the shim
# directory counts as this script. A copy of a shim has another inode, so -ef
# misses it: the marker on line 2 skips it instead, or two stacked shim
# directories would call each other without end. Run by a path outside PATH,
# the shim never meets itself and takes /usr/bin or /bin only.
real_wc=""
met_self=0
IFS=: read -r -a path_parts <<<"$PATH"
system_at=${#path_parts[@]}
path_parts+=(/usr/bin /bin)
for i in "${!path_parts[@]}"; do
	part="${path_parts[i]}"
	((i == system_at)) && met_self=1
	if [[ "$part/wc" -ef "${BASH_SOURCE[0]}" ]]; then
		met_self=1
	elif ((met_self)) && [[ -x "$part/wc" ]] &&
		! grep -q '^# loom-bsd-shim' "$part/wc" 2>/dev/null; then
		real_wc="$part/wc"
		break
	fi
done
[[ -n "$real_wc" ]] || { echo "wc: no real wc on PATH" >&2; exit 127; }
out=$("$real_wc" "$@") || exit $?
[[ -n "$out" ]] || exit 0
field_re='^[[:space:]]*([0-9]+)([[:space:]].*|)$'
while IFS= read -r line; do
	rest="$line"
	padded=""
	while [[ "$rest" =~ $field_re ]]; do
		padded="${padded}$(printf '%8d' "$((10#${BASH_REMATCH[1]}))")"
		rest="${BASH_REMATCH[2]}"
	done
	printf '%s%s\n' "$padded" "$rest"
done <<<"$out"
