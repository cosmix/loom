#!/usr/bin/env bash
# loom-bsd-shim
# BSD/macOS wc shim: GNU wc with the BSD output shape. Every leading integer
# field is right-aligned in 8 columns (`wc -c <file` prints "       5"), so a
# hook that tests the raw value against ^[0-9]+$ fails here as it does on macOS.

# The real tool is the first PATH entry (then /usr/bin, /bin) that is not this
# script; -ef follows symlinks, so a path_without mirror of the shim directory
# is skipped too. A copy of a shim has another inode, so -ef misses it: the
# marker on line 2 skips it instead, or two stacked shim directories would call
# each other without end.
real_wc=""
IFS=: read -r -a path_parts <<<"$PATH:/usr/bin:/bin"
for part in "${path_parts[@]}"; do
	if [[ -x "$part/wc" && ! "$part/wc" -ef "${BASH_SOURCE[0]}" ]] &&
		! grep -q '^# loom-bsd-shim' "$part/wc" 2>/dev/null; then
		real_wc="$part/wc"
		break
	fi
done
[[ -n "$real_wc" ]] || { echo "wc: no real wc on PATH" >&2; exit 127; }
out=$("$real_wc" "$@") || exit $?
[[ -n "$out" ]] || exit 0
field_re='^[[:space:]]*([0-9]+)([[:space:]].*|)$'
while IFS= read -r line; do
	rest="$line"
	padded=""
	while [[ "$rest" =~ $field_re ]]; do
		padded="${padded}$(printf '%8d' "$((10#${BASH_REMATCH[1]}))")"
		rest="${BASH_REMATCH[2]}"
	done
	printf '%s%s\n' "$padded" "$rest"
done <<<"$out"
