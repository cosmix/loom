#!/usr/bin/env bash
# loom-bsd-shim
# BSD/macOS stat shim over GNU stat: rejects -c like BSD stat and answers
# `stat -f FORMAT FILE` for the directives the hooks use, translated to GNU
# `stat -c`. %d %i %u pass through, %z -> %s (size), %m -> %Y (mtime) and
# %Lp -> %a (octal mode). Any other directive exits 1.
# On a host whose real stat is already BSD (macOS) the shim steps aside and runs it.

depth=${LOOM_BSD_SHIM_DEPTH:-0}
((depth < 3)) || { echo "stat: BSD shim re-entered ${depth} times; a PATH wrapper delegates back to it" >&2; exit 125; }
export LOOM_BSD_SHIM_DEPTH=$((depth + 1))

# The real tool is the next PATH entry after this script's own (then /usr/bin,
# /bin). A wrapper earlier on PATH may delegate back to the shim
# (worktree-file-guard-scratchpad's stat stub), so taking the first entry that
# is not this script would pick the wrapper and loop; the depth guard above is
# the backstop. -ef follows symlinks, so a path_without mirror of the shim
# directory counts as this script. A copy of a shim has another inode, so -ef
# misses it: the marker on line 2 skips it instead, or two stacked shim
# directories would call each other without end. Run by a path outside PATH,
# the shim never meets itself and takes /usr/bin or /bin only.
real_stat=""
met_self=0
IFS=: read -r -a path_parts <<<"$PATH"
system_at=${#path_parts[@]}
path_parts+=(/usr/bin /bin)
for i in "${!path_parts[@]}"; do
	part="${path_parts[i]}"
	((i == system_at)) && met_self=1
	if [[ "$part/stat" -ef "${BASH_SOURCE[0]}" ]]; then
		met_self=1
	elif ((met_self)) && [[ -x "$part/stat" ]] &&
		! grep -q '^# loom-bsd-shim' "$part/stat" 2>/dev/null; then
		real_stat="$part/stat"
		break
	fi
done
[[ -n "$real_stat" ]] || { echo "stat: no real stat on PATH" >&2; exit 127; }
# GNU stat answers --version; BSD stat rejects it.
"$real_stat" --version >/dev/null 2>&1 || exec "$real_stat" "$@"

translate_format() {
	local fmt="$1" i=0 out="" char="" next=""
	while ((i < ${#fmt})); do
		char="${fmt:i:1}"
		if [[ "$char" != "%" ]]; then
			out="${out}${char}"; i=$((i + 1)); continue
		fi
		next="${fmt:i+1:1}"
		if [[ "${fmt:i+1:2}" == "Lp" ]]; then
			out="${out}%a"; i=$((i + 3)); continue
		fi
		case "$next" in
		d | i | u) out="${out}%${next}" ;;
		z) out="${out}%s" ;;
		m) out="${out}%Y" ;;
		*) echo "stat: unsupported format directive in '$fmt'" >&2; return 1 ;;
		esac
		i=$((i + 2))
	done
	printf '%s' "$out"
}

case "${1:-}" in
-c*)
	echo "stat: illegal option -- c" >&2
	exit 1
	;;
-f)
	[[ $# -ge 3 ]] || { echo "usage: stat -f format file ..." >&2; exit 1; }
	gnu_format=$(translate_format "$2") || exit 1
	shift 2
	exec "$real_stat" -c "$gnu_format" "$@"
	;;
*)
	exec "$real_stat" "$@"
	;;
esac
